# =============================================================
# ThreatMail — Environment Variables
# Author: Rayen Lassoued
# =============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ------------------------------------------------------------------
# LLM PROVIDER (required)
# ------------------------------------------------------------------
# Your OpenAI API key OR an OpenRouter key
# OpenRouter free tier: https://openrouter.ai (no credit card needed)
OPENAI_API_KEY=your-openai-or-openrouter-api-key

# Base URL override — leave blank for OpenAI; set for OpenRouter:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=

# Model name: gpt-4.1-mini (OpenAI) or openai/gpt-4o-mini (OpenRouter)
LLM_MODEL=gpt-4.1-mini

# Temperature for LLM responses (0.0 = deterministic)
LLM_TEMPERATURE=0.2

# ------------------------------------------------------------------
# THREAT INTELLIGENCE (optional — system works without it)
# ------------------------------------------------------------------
# VirusTotal free API: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=your-virustotal-api-key

# ------------------------------------------------------------------
# SERVICE CONFIGURATION
# ------------------------------------------------------------------
PORT=8000
MODEL_PROVIDER=openrouter
VITE_API_URL=http://localhost:8000
